{{#if (Equal Parameters.IdentityType "SystemAssigned")}}
locals {
  {{name}} = {
    principalId   = azurerm_container_app.{{Parameters.IdentityResourceName}}.identity[0].principal_id
  }
}
{{else}}
resource "azurerm_user_assigned_identity" "{{name}}" {
  name                = "${replace(local.name_template, "<service>", "uai")}-{{name}}"
  resource_group_name = azurerm_resource_group.app.name
  location            = var.location
  tags                = merge (local.tags, {
    aspire-resource-name = "{{name}}"
  })  
}

locals {
  {{name}} = {
    id            = azurerm_user_assigned_identity.{{name}}.id
    clientId      = azurerm_user_assigned_identity.{{name}}.client_id
    principalId   = azurerm_user_assigned_identity.{{name}}.principal_id
    principalName = azurerm_user_assigned_identity.{{name}}.name
    name          = azurerm_user_assigned_identity.{{name}}.name
  }
}
{{/if}}

output "{{name}}" {
  value = local.{{name}}
}
