resource "azurerm_mssql_server" "{{name}}" {
  name                = "${replace(local.name_template, "<service>", "sql")}-{{name}}"
  resource_group_name = azurerm_resource_group.app.name
  location            = var.location
  version             = "12.0"
  minimum_tls_version = "1.2"
  tags                = merge (local.tags, {
    aspire-resource-name = "{{name}}"
  })
  public_network_access_enabled = true

  azuread_administrator {
    azuread_authentication_only = true
{{#if Parameters.IdentityPrincipalId }}
    login_username              = "{{Parameters.IdentityPrincipalName}}"
    object_id                   = {{TfRemoveBraces Parameters.IdentityPrincipalId}}
{{else}}
    login_username              = azurerm_user_assigned_identity.app.name
    object_id                   = azurerm_user_assigned_identity.app.principal_id
{{/if}}
    tenant_id                   = data.azurerm_client_config.current.tenant_id
  }
}

resource "azurerm_mssql_firewall_rule" "{{name}}-allowallazure" {
  name             = "AllowAllAzureIps"
  server_id        = azurerm_mssql_server.{{name}}.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}

{{#Parameters.RoleAssignments}}
{{#Roles}}
resource "azurerm_role_assignment" "{{../../Name}}_{{../Target.Name}}_{{@index}}" {
  scope                = local.{{TfRemoveBraces ../Target.Name}}.id
{{#if Id}}  
  role_definition_id   = "{{Id}}" // {{Name}}
{{else}}
  role_definition_name = "{{Name}}"
{{/if}}
  principal_id         = azurerm_container_app.{{../Target.Name}}.identity[0].principal_id
}

{{/Roles}}
{{/Parameters.RoleAssignments}}
locals {
  {{name}} = {
    id = azurerm_mssql_server.{{name}}.id
    name = azurerm_mssql_server.{{name}}.name
    sqlServerFqdn = azurerm_mssql_server.{{name}}.fully_qualified_domain_name
  }
}

output "{{name}}" {
  value = local.{{name}}
}

