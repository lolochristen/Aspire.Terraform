resource "azurerm_key_vault_secret" "{{name}}" {
  name         = "{{Resource.SecretName}}"
  value        = "{{value}}"
  key_vault_id = azurerm_key_vault.{{parent.name}}.id
  depends_on   = [azurerm_role_assignment.kv_admin_current_{{parent.name}}]
}

locals {
  {{name}} = {
    key_vault_secret_id = azurerm_key_vault_secret.{{name}}.versionless_id
  }
}
